# KNeighbors Regressor (KNR)
from sklearn.model_selection import GridSearchCV, RepeatedKFold
from sklearn.neighbors import KNeighborsRegressor

# --- Expanded parameter grid (more robust) ---
param_grid = {
    'n_neighbors': [3, 5, 7, 9, 11, 15, 20],   # increased range
    'weights': ['uniform', 'distance'],
    'p': [1, 2]
}

# --- Better cross-validation ---
cv = RepeatedKFold(n_splits=5, n_repeats=3, random_state=42)

# --- Initialize model ---
regressor = KNeighborsRegressor()

# --- GridSearch ---
grid_search = GridSearchCV(
    estimator=regressor,
    param_grid=param_grid,
    cv=cv,
    scoring='r2',          # maximize R²
    n_jobs=-1              # use all cores (faster)
)

# --- Fit ---
grid_search.fit(X_train_scaled, y_train)

# --- Results ---
print(f"Best parameters: {grid_search.best_params_}")
print(f"Best CV R² score: {grid_search.best_score_:.3f}")
