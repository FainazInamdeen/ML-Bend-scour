# ---Multiple Linear Regression (MLR) Model ---
regressor1 = LinearRegression(fit_intercept=True, copy_X=True)

# IMPORTANT: use SCALED data here
regressor1.fit(X_train_scaled, y_train)

# Predictions
y_pred = regressor1.predict(X_test_scaled)
y_obs = y_test.values

# --- Metrics ---
r2 = r2_score(y_obs, y_pred)
rmse = np.sqrt(mean_squared_error(y_obs, y_pred))
mae = mean_absolute_error(y_obs, y_pred)

# --- Output ---
print(f"R²   : {r2:.4f}")
print(f"RMSE : {rmse:.4f}")
print(f"MAE  : {mae:.4f}")


